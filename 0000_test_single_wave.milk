MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2

[preset00]
fRating=3.000000
fGammaAdj=2.000000
fDecay=0.940000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=1.000000
fWaveScale=1.000000
fWaveSmoothing=0.500000
fWaveParam=0.000000
fModWaveAlphaStart=0.000000
fModWaveAlphaEnd=0.000000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=1.000000
sx=1.000000
sy=1.000000
wave_r=1.000000
wave_g=1.000000
wave_b=1.000000
wave_x=0.500000
wave_y=0.500000
ob_size=0.010000
ob_r=0.000000
ob_g=0.000000
ob_b=0.000000
ob_a=0.000000
ib_size=0.010000
ib_r=0.250000
ib_g=0.250000
ib_b=0.250000
ib_a=0.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
mv_dx=0.000000
mv_dy=0.000000
mv_l=0.000000
mv_r=1.000000
mv_g=1.000000
mv_b=1.000000
mv_a=0.000000

// 自定义波形全部关闭（只使用上面的 simple waveform）
wavecode_0_enabled=0
wavecode_1_enabled=0
wavecode_2_enabled=0
wavecode_3_enabled=0

// 自定义形状全部关闭
shapecode_0_enabled=0
shapecode_1_enabled=0
shapecode_2_enabled=0
shapecode_3_enabled=0

per_frame_1=
per_frame_2=// 此预设保持静态：波形样式完全由 [preset00] 的 nWaveMode + wave_* 决定，
per_frame_3=// 便于用 wave 面板注入 wave_mode / wave_x / wave_y / wave_r/g/b 等参数进行测试。

per_pixel_1=

// warp shader：对上一帧做轻微淡出，形成波形的拖尾效果
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv) * 0.92;
warp_4=`}

// comp shader：原样输出当前帧（波形已由 projectM 内置渲染器叠加到 main）
comp_1=`
comp_2=`shader_body
comp_3=`{
comp_4=`    ret = tex2D(sampler_main, uv);
comp_5=`}

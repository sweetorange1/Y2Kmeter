# ==========================================================
# Y2Kmeter 语言包 —— 简体中文
#
#   格式（详见 source/i18n/Localisation.h）：
#     @key = value                 元数据
#     "English source" = "译文"     条目；支持 \n \t \" \\ 转义；# 开头为注释
#
#   查表顺序：整串精确 → 去首尾空白 → 数字模板化 → 多行逐行。
#     数字模板：源文案里的数字依次替换成 {0} {1} ...，例如
#       "SAVE LAST 10 s" 未精确命中时按 "SAVE LAST {0} s" 查表。
#   缺译条目自动回退英文原文。
#
#   运行期覆盖：把同名 zh-CN.lang（只需写要改的条目）放到
#     Windows: %APPDATA%\Y2Kmeter\lang\
#     macOS  : ~/Library/Application Support/Y2Kmeter/lang/
#   重启后生效，不必重新编译。
# ==========================================================

@code          = zh-CN
@name          = 简体中文
@label         = 中文
@order         = 10
@match         = zh
@font          = ChillBitmap_16px.ttf
@fontScale     = 0.85
@minFontHeight = 11


!/third_party/JUCE/extras/Build/
/build-clangd/
/compile_commands.json
# macOS 适配：build_macos_installer.sh 默认使用 build/ 与 build_*/ 作为构建输出目录
/build/
/build_*/

# IDE configurations
/.vs/
/.idea/

# Temporary files
/_filterstate.*
/color.txt

# Test directories
/pngtest/

# Large binary files
/grid_plugin.zip

# OS-specific files
/desktop.ini

# Python cache files
__pycache__/
*.pyc

# CMake build artifacts
CMakeCache.txt
cmake_install.cmake
CMakeFiles/
Makefile
*.cmake
# 放行 JUCE 的 .cmake 构建支撑文件，不可忽略
!/third_party/JUCE/**/*.cmake

# Compiled objects and libraries
*.o
*.a
*.so
*.dll
*.lib
*.exe

# Debug and release builds
Debug/
Release/
*.pdb
*.idb

# JUCE specific build artifacts
JUCE/
JUCEArtwork/

# Allow third_party/JUCE (local checkout, committed for cross-machine consistency)
!/third_party/JUCE/

# macOS specific
.DS_Store

# Windows specific
Thumbs.db

# Backup files
*~
*.bak
*.backup

.vscodenul

